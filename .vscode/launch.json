// A launch configuration that compiles the extension and then opens it inside a new window
{
	"version": "0.1.0",
	"configurations": [
		{
			"name": "Attach to lspserver",
			"type": "node",
			"request": "attach",
			"port": 6011
		},
		{
			"name": "debugger Server",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/lib/erlangDebug.ts",
			"args": [
				"--server=4711"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			]
		},
		{
			"name": "Launch Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceRoot}" ],
			"sourceMaps": true,
			"outFiles": ["${workspaceRoot}/out"],
		},
		{
			// Opens the sample project (see TESTING.md there) as the workspace,
			// for manually exercising code actions, navigation/hierarchies and
			// the Test Explorer. No `--disable-extensions`, unlike "Launch
			// Tests" below: this wants a normal editing environment.
			"name": "Launch Extension (sample project)",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/../../erlang/sample",
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/out/**/*.js"],
			"preLaunchTask": "npm: compile"
		},
		{
			"name": "Launch Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/test/test-fixtures/",
				"--disable-extensions",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionTestsPath=${workspaceRoot}/out/test/test-suite" 
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/out/**/*.js"],
			"preLaunchTask": "prepareTest",
			// "postDebugTask": "cleanTestFolder"
		}
	]
}
