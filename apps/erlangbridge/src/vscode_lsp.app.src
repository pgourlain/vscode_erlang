{application, vscode_lsp, [
    {description, "Erlang Language Server Protocol for VSCode"},
    {vsn, "0.1.0"},
    {registered, [vscode_lsp_app]},
    {modules, [
        vscode_lsp_app, vscode_gen_lsp_sup, vscode_gen_lsp_server,
        vscode_gen_lsp_doc_sup, vscode_gen_lsp_doc_server,
        vscode_gen_lsp_config_sup, vscode_gen_lsp_config_server,
        vscode_gen_lsp_help_sup, vscode_gen_lsp_help_server, 
        vscode_lsp_navigation, vscode_lsp_syntax, vscode_lsp_utils
    ]},
    {applications, [kernel, stdlib]},
    {mod, {vscode_lsp_app, []}},
    {env, []}
 ]}.
 