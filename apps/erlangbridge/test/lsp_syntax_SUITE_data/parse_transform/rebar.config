%% Fixture for lsp_syntax_SUITE:parse_transform_from_rebar_config_is_applied.
%% Declares the transform the way rebar3/erlc actually take it - as an
%% erl_opts entry, with no -compile({parse_transform, ...}) attribute in
%% consumer.erl at all (#216).
%%
%% base_dir is "fixture_build", not the default "_build": lsp_syntax's
%% module loader (find_source/1) only locates inject_helper.erl by
%% wildcarding under gen_lsp_doc_server:get_build_dir(), and this repo's
%% .gitignore excludes every "_build/" directory - a fixture actually
%% named that way would silently vanish from version control.
{base_dir, "fixture_build"}.
{erl_opts, [{parse_transform, inject_helper}]}.
